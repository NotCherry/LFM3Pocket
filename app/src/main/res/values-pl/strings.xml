    <!-- Home & About -->
    <string name="home_on_device">NA URZĄDZENIU</string>
    <string name="home_tagline">Modele Liquid AI LFM3, prywatnie na tym telefonie.</string>
    <string name="home_no_model_title">Brak załadowanego modelu</string>
    <string name="home_no_model_hint">Zaimportuj lub otwórz plik LFM3 GGUF w Ustawieniach, aby rozmawiać offline.</string>
    <string name="home_setup_model">Skonfiguruj</string>
    <string name="home_model_ready_suffix">Na urządzeniu · lokalna inferencja</string>
    <string name="back_to_home">Wróć na ekran główny</string>
    <string name="about_version_format">Wersja %1$s · AI na urządzeniu</string>
    <string name="about_lead">Hanami uruchamia modele Liquid AI LFM3 bezpośrednio na tym telefonie. LFM3 to rodzina modeli, a Hanami to aplikacja.</string>
    <string name="about_section_privacy_title">PRYWATNOŚĆ DOMYŚLNIE</string>
    <string name="about_section_privacy_body">Tekst, zdjęcia, dokumenty i głos są przetwarzane lokalnie przez llama.cpp bez telemetrii. Opcjonalne wyszukiwanie HTTPS SearXNG pozostaje wyłączone, dopóki nie włączysz go w Ustawieniach.</string>
    <string name="about_section_actions_title">CHRONIONE AKCJE ANDROIDA</string>
    <string name="about_section_actions_body">Proponowane przez model minutniki, alarmy, przypomnienia i wpisy kalendarza nigdy nie wykonują się po cichu — wrażliwe akcje wymagają jednorazowego zatwierdzenia.</string>

